. *---------------------------------------------------------------
. * SECTION 2: ECRASH CRASH RECORDS (3 SEP 2019 TO 2024)
. *---------------------------------------------------------------
. * Source: Mississippi eCrash public data requests; request date is in each fi
> le name
. * (site and download date in dataRAW/DVCs/MS/source.txt)
. * Each pass reads one workbook (sheets Crashes, Vehicles, Drivers, Passengers
> ,
. * Non-Motorists), joins on crashid and saves one row per crash.
. * Headers checked in the 2020, 2023 and 2024 files; 2019, 2021, 2022 not chec
> ked.
. 
. local ec_2019 "Public Data Request 21-02-04 1755 (19-01-01 to 19-12-31).xlsx"

. local ec_2020 "Public Data Request 21-01-15 1700 (20-01-01 to 21-01-01).xlsx"

. local ec_2021 "Public Data Request 22-04-12 1535 (21-01-01 to 21-12-31).xlsx"

. local ec_2022 "Public Data Request 24-01-12 1055 (22-01-01 to 22-12-31).xlsx"

. * 2023-24 files are marked DRAFT; Section 4 checks they cover all 12 months
. local ec_2023 "Public Data Request 25-02-27 1725 (23-01-01 to 23-12-31) DRAFT
> .xlsx"

. local ec_2024 "Public Data Request 25-02-27 1733 (24-01-01 to 24-12-31) DRAFT
> .xlsx"

. 
. tempfile ec_all

. local is_first = 1

. forvalues file_year = 2019/2024 {
  2.     local file_name = "$ms_raw/`ec_`file_year''"
  3.     di as txt _n "eCrash `file_year'"
  4. 
.     * Animal: any vehicle whose sequence of events is "Collision with animal 
> (live)"
.     import excel using "`file_name'", sheet("Vehicles") firstrow case(lower) 
> allstring clear
  5.     keep crashid sequenceofevents*
  6.     gen is_animal = 0
  7.     foreach v of varlist sequenceofevents* {
  8.         replace is_animal = 1 if strpos(lower(`v'), "collision with animal
> ") > 0
  9.     }
 10.     collapse (max) is_animal, ///
>              by(crashid)
 11.     save `vehicles', replace
 12. 
.     * Severity: worst injury status across drivers, passengers and non-motori
> sts
.     local is_first_sheet = 1
 13.     foreach sheet_name in "Drivers" "Passengers" "Non-Motorists" {
 14.         import excel using "`file_name'", sheet("`sheet_name'") firstrow c
> ase(lower) allstring clear
 15.         keep crashid ///
>              injurystatus
 16.         if !`is_first_sheet' append using `persons'
 17.         save `persons', replace
 18.         local is_first_sheet = 0
 19.     }
 20.     * Injury status reads e.g. "(K) Fatal Injury"; character 2 is the KABC
> O letter
.     gen temp = substr(injurystatus, 2, 1)
 21.     gen sev_rank = 5*(temp == "K") ///
>                       + 4*(temp == "A") ///
>                       + 3*(temp == "B") ///
>                       + 2*(temp == "C") ///
>                       + 1*(temp == "O")
 22.     drop temp
 23.     collapse (max) sev_rank, ///
>              by(crashid)
 24.     save `persons', replace
 25. 
.     * Crashes: one row per crash
.     import excel using "`file_name'", sheet("Crashes") firstrow case(lower) c
> lear
 26.     keep crashid       ///
>          crashdate     ///
>          countyid      ///
>          fatalitycount ///
>          injurycount   ///
>          alcoholinvolvement
 27.     * Crash Date is text ("2024/01/01") in the 2024 file; handle an Excel 
> date too
.     cap confirm string variable crashdate
 28.     if _rc == 0 gen crash_date = date(crashdate, "YMD")
 29.     else gen crash_date = crashdate
 30.     format crash_date %td
 31.     * Undated crashes are dropped below; stop if the date format was not r
> ead
.     count if missing(crash_date)
 32.     di as txt r(N) " crashes with no readable date"
 33.     assert r(N) < 0.01 * _N
 34.     * 2019 starts at the switch date; the 2020 file runs to 1 Jan 2021
.     if `file_year' == 2019 keep if crash_date >= $ms_switch & year(crash_date
> ) == 2019
 35.     else keep if year(crash_date) == `file_year'
 36.     gen is_alcohol = strtrim(lower(alcoholinvolvement)) == "yes"
 37. 
.     merge 1:1 crashid using `vehicles'
 38.     drop if _merge == 2
 39.     drop _merge
 40.     merge 1:1 crashid using `persons'
 41.     drop if _merge == 2
 42.     drop _merge
 43. 
.     * Crashes with no vehicle or person rows: no animal, unknown severity
.     foreach v in is_animal sev_rank {
 44.         replace `v' = 0 if missing(`v')
 45.     }
 46. 
.     rename countyid county_nmbr
 47.     rename fatalitycount total_fatalities
 48.     rename injurycount total_injuries
 49.     gen year = `file_year'
 50.     keep county_nmbr      ///
>          year             ///
>          crash_date       ///
>          total_fatalities ///
>          total_injuries   ///
>          sev_rank         ///
>          is_animal        ///
>          is_alcohol
 51. 
.     if !`is_first' append using `ec_all'
 52.     save `ec_all', replace
 53.     local is_first = 0
 54. }

