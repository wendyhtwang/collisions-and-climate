. * Each pass builds one cause's severity split. cond() keeps non-cause
. * crashes at 0 even when their injury or fatality count is missing.
. foreach cause in animal alcohol {
  2.     gen `cause'_collision              = is_`cause'
  3.     gen fatal_`cause'_collision        = is_`cause' * fatal_collision
  4.     gen injury_`cause'_collision       = is_`cause' * injury_collision
  5.     gen major_injury_`cause'_collision = is_`cause' * major_injury_collisi
> on
  6.     gen minor_injury_`cause'_collision = is_`cause' * minor_injury_collisi
> on
  7.     gen pdo_`cause'                    = is_`cause' * pdo_collision
  8.     gen `cause'_fatalities = cond(is_`cause' == 1, total_fatalities, 0)
  9.     gen `cause'_injuries   = cond(is_`cause' == 1, total_injuries, 0)
 10. }
