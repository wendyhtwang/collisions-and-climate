> ionsDataRepo/logs/clean_MS.log
  log type:  text
 opened on:  16 Nov 2026, 11:00:44

. 
. set excelxlsxlargefile on

. 
. * Some ReportBeam tables hold broken rows (the 2006 v
> ehicle table has crash ID
. * "PRO") that make the ID column text; drop them so e
> very table keys on a number
. cap program drop drop_bad_ids

. program define drop_bad_ids
  1.     destring intcrashid, replace force
  2.     count if missing(intcrashid)
  3.     di as txt r(N) " rows with a non-numeric crash
>  ID dropped"
  4.     drop if missing(intcrashid)
  5. end

. 
. *----------------------------------------------------
> -----------
. * SECTION 1: REPORTBEAM CRASH RECORDS (2004 TO 2 SEP 
> 2019)
. *----------------------------------------------------
> -----------
. * Source: Mississippi ReportBeam crash export, one fo
> lder of five tables per year
. * (site and download date in dataRAW/DVCs/MS/source.t
> xt)
. * Each pass joins one year's tables on intcrashid and
>  saves one row per crash:
. * county, worst injury (KABCO), animal and alcohol fl
> ags.
. * Code values (14 = Animal; conditions 4, 5, 7) are l
> isted in
. * dataRAW/DVCs/MS/ReportBeamCodeValueTable.txt.
. * Column names checked across 2004-2019 (not every ta
> ble in every year).
. 
. tempfile rb_all    ///
>          vehicles  ///
>          occupants ///
>          persons

. local is_first = 1

. forvalues file_year = 2004/2019 {
  2.     local folder = "$ms_raw/ReportBeam-`file_year'
> -CrashData/ReportBeam-`file_year'"
  3.     di as txt _n "ReportBeam `file_year'"
  4. 
.     * Animal: any vehicle with sequence-of-events cod
> e 14 (Animal)
.     local file_name = "`folder'-CrashVehicleTable.xls
> x"
  5.     import excel using "`file_name'", firstrow cas
> e(lower) clear
  6.     keep intcrashid v20_*
  7.     drop_bad_ids
  8.     gen is_animal = 0
  9.     foreach v of varlist v20_* {
 10.         cap destring `v', replace force
 11.         replace is_animal = 1 if `v' == 14
 12.     }
 13.     collapse (max) is_animal, ///
>              by(intcrashid)
 14.     save `vehicles', replace
 15. 
.     * Passengers: injury severity only
.     local file_name = "`folder'-CrashOccupantTable.xl
> sx"
 16.     import excel using "`file_name'", firstrow cas
> e(lower) allstring clear
 17.     keep intcrashid ///
>          o13_injury_severity_cd
 18.     rename o13_injury_severity_cd injury_severity
 19.     drop_bad_ids
 20.     save `occupants', replace
 21. 
.     * Drivers and non-motorists: injury severity and 
> alcohol
.     local file_name = "`folder'-CrashPersonTable.xlsx
> "
 22.     import excel using "`file_name'", firstrow cas
> e(lower) allstring clear
 23.     keep intcrashid             ///
>          p23_injury_severity_cd ///
>          p19_condition_cd       ///
>          p32_alcohol_result
 24.     rename p23_injury_severity_cd injury_severity
 25.     drop_bad_ids
 26.     destring p19_condition_cd, ///
>              replace force
 27.     gen bac = real(p32_alcohol_result)
 28.     * DECISION (pending): alcohol rule. Conditions
>  4, 5, 7 = drinking; or BAC > 0.
.     * Closest of the rules tested to eCrash's crash-l
> evel flag.
.     gen is_alcohol = inlist(p19_condition_cd, 4, 5, 7
> ) | (bac > 0 & !missing(bac))
 29.     append using `occupants'
 30.     replace is_alcohol = 0 if missing(is_alcohol)
 31.     * KABCO rank: 5 = K, 4 = A, 3 = B, 2 = C, 1 = 
> D (none), 0 = blank
.     replace injury_severity = strtrim(upper(injury_se
> verity))
 32.     gen sev_rank = 5*(injury_severity == "K") ///
>                       + 4*(injury_severity == "A") //
> /
>                       + 3*(injury_severity == "B") //
> /
>                       + 2*(injury_severity == "C") //
> /
>                       + 1*(injury_severity == "D")
 33.     collapse (max) sev_rank    ///
>                    is_alcohol, ///
>              by(intcrashid)
 34.     save `persons', replace
 35. 
.     * Crashes: one row per crash
.     local file_name = "`folder'-CrashTable.xlsx"
 36.     import excel using "`file_name'", firstrow cas
> e(lower) clear
 37.     keep intcrashid       ///
>          g1_county_nmbr   ///
>          g3_reported_date ///
>          g7_fatal_cnt     ///
>          g8_injury_cnt
 38.     drop_bad_ids
 39.     destring g1_county_nmbr ///
>              g7_fatal_cnt   ///
>              g8_injury_cnt, ///
>              replace force
 40.     * A date-time in 2018. If broken rows made the
>  column text, parse the text:
.     * an Excel day number, or a written date-time
.     cap confirm string variable g3_reported_date
 41.     if _rc == 0 {
 42.         gen crash_date = floor(real(g3_reported_da
> te)) + td(30dec1899)
 43.         replace crash_date = dofc(clock(g3_reporte
> d_date, "YMDhms")) if missing(crash_date)
 44.         replace crash_date = dofc(clock(g3_reporte
> d_date, "MDYhms")) if missing(crash_date)
 45.     }
 46.     else {
 47.         local date_format : format g3_reported_dat
> e
 48.         if substr("`date_format'", 1, 3) == "%tc" 
> gen crash_date = dofc(g3_reported_date)
 49.         else gen crash_date = g3_reported_date
 50.     }
 51.     format crash_date %td
 52.     count if missing(crash_date)
 53.     di as txt r(N) " crashes with no date (kept in
>  `file_year')"
 54.     count if year(crash_date) != `file_year'
 55.     di as txt r(N) " crashes dated outside `file_y
> ear' (kept in `file_year')"
 56. 
.     * eCrash covers 2019 from the switch date, so lat
> er ReportBeam records are dropped
.     * DECISION (pending): about 1,200 late records, m
> ost of them not in eCrash
.     if `file_year' == 2019 {
 57.         count if crash_date >= $ms_switch & !missi
> ng(crash_date)
 58.         di as txt "Dropping " r(N) " ReportBeam cr
> ashes on or after the eCrash switch"
 59.         drop if crash_date >= $ms_switch & !missin
> g(crash_date)
 60.     }
 61. 
.     * Vehicle and person rows of dropped crashes have
>  no match and are discarded
.     merge 1:1 intcrashid using `vehicles'
 62.     drop if _merge == 2
 63.     drop _merge
 64.     merge 1:1 intcrashid using `persons'
 65.     drop if _merge == 2
 66.     drop _merge
 67. 
.     * Crashes with no vehicle or person rows: no anim
> al, no alcohol, unknown severity
.     foreach v in is_animal is_alcohol sev_rank {
 68.         replace `v' = 0 if missing(`v')
 69.     }
 70. 
.     rename g1_county_nmbr county_nmbr
 71.     rename g7_fatal_cnt total_fatalities
 72.     rename g8_injury_cnt total_injuries
 73.     gen year = `file_year'
 74.     * Crash IDs are numeric here and text in eCras
> h, so they are not kept
.     keep county_nmbr      ///
>          year             ///
>          crash_date       ///
>          total_fatalities ///
>          total_injuries   ///
>          sev_rank         ///
>          is_animal        ///
>          is_alcohol
 75. 
.     if !`is_first' append using `rb_all'
 76.     save `rb_all', replace
 77.     local is_first = 0
 78. }

