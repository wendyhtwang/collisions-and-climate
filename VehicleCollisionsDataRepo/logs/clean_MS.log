> MS.log
  log type:  text
 opened on:  16 Nov 2026, 13:41:25

. 
. set excelxlsxlargefile on

. 
. * Some ReportBeam tables hold broken rows (the 2006 vehicle table has crash I
> D
. * "PRO") that make the ID column text; drop them so every table keys on a num
> ber
. cap program drop drop_bad_ids

. program define drop_bad_ids
  1.     destring intcrashid, replace force
  2.     count if missing(intcrashid)
  3.     di as txt r(N) " rows with a non-numeric crash ID dropped"
  4.     drop if missing(intcrashid)
  5. end

. 
. *---------------------------------------------------------------
. * SECTION 1: REPORTBEAM CRASH RECORDS (2004 TO 2 SEP 2019)
. *---------------------------------------------------------------
. * Source: Mississippi ReportBeam crash export, one folder of five tables per 
> year
. * (site and download date in dataRAW/DVCs/MS/source.txt)
. * Each pass joins one year's tables on intcrashid and saves one row per crash
> :
. * county, worst injury (KABCO), animal and alcohol flags.
. * Code values (14 = Animal; conditions 4, 5, 7) are listed in
. * dataRAW/DVCs/MS/ReportBeamCodeValueTable.txt.
. * Column names checked across 2004-2019 (not every table in every year).
. 
. tempfile rb_all    ///
>          vehicles  ///
>          occupants ///
>          persons

. local is_first = 1

. forvalues file_year = 2004/2019 {
  2.     local folder = "$ms_raw/ReportBeam-`file_year'-CrashData/ReportBeam-`f
> ile_year'"
  3.     di as txt _n "ReportBeam `file_year'"
  4. 
.     * Animal: any vehicle with sequence-of-events code 14 (Animal)
.     local file_name = "`folder'-CrashVehicleTable.xlsx"
  5.     import excel using "`file_name'", firstrow case(lower) clear
  6.     keep intcrashid v20_*
  7.     drop_bad_ids
  8.     gen is_animal = 0
  9.     foreach v of varlist v20_* {
 10.         cap destring `v', replace force
 11.         replace is_animal = 1 if `v' == 14
 12.     }
 13.     collapse (max) is_animal, ///
>              by(intcrashid)
 14.     save `vehicles', replace
 15. 
.     * Passengers: injury severity only
.     local file_name = "`folder'-CrashOccupantTable.xlsx"
 16.     import excel using "`file_name'", firstrow case(lower) allstring clear
 17.     keep intcrashid ///
>          o13_injury_severity_cd
 18.     rename o13_injury_severity_cd injury_severity
 19.     drop_bad_ids
 20.     save `occupants', replace
 21. 
.     * Drivers and non-motorists: injury severity and alcohol
.     local file_name = "`folder'-CrashPersonTable.xlsx"
 22.     import excel using "`file_name'", firstrow case(lower) allstring clear
 23.     keep intcrashid             ///
>          p23_injury_severity_cd ///
>          p19_condition_cd       ///
>          p32_alcohol_result
 24.     rename p23_injury_severity_cd injury_severity
 25.     drop_bad_ids
 26.     destring p19_condition_cd, ///
>              replace force
 27.     gen bac = real(p32_alcohol_result)
 28.     * DECISION (pending): alcohol rule. Conditions 4, 5, 7 = drinking; or 
> BAC > 0.
.     * Closest of the rules tested to eCrash's crash-level flag.
.     gen is_alcohol = inlist(p19_condition_cd, 4, 5, 7) | (bac > 0 & !missing(
> bac))
 29.     append using `occupants'
 30.     replace is_alcohol = 0 if missing(is_alcohol)
 31.     * KABCO rank: 5 = K, 4 = A, 3 = B, 2 = C, 1 = D (none), 0 = blank
.     replace injury_severity = strtrim(upper(injury_severity))
 32.     gen sev_rank = 5*(injury_severity == "K") ///
>                       + 4*(injury_severity == "A") ///
>                       + 3*(injury_severity == "B") ///
>                       + 2*(injury_severity == "C") ///
>                       + 1*(injury_severity == "D")
 33.     collapse (max) sev_rank    ///
>                    is_alcohol, ///
>              by(intcrashid)
 34.     save `persons', replace
 35. 
.     * Crashes: one row per crash
.     local file_name = "`folder'-CrashTable.xlsx"
 36.     import excel using "`file_name'", firstrow case(lower) clear
 37.     keep intcrashid       ///
>          g1_county_nmbr   ///
>          g3_reported_date ///
>          g7_fatal_cnt     ///
>          g8_injury_cnt
 38.     drop_bad_ids
 39.     destring g1_county_nmbr ///
>              g7_fatal_cnt   ///
>              g8_injury_cnt, ///
>              replace force
 40.     * A date-time in 2018. A split row makes the column text (2012, 2015-2
> 018),
.     * and Stata then writes each date as text; read the date from its first w
> ord
.     cap confirm string variable g3_reported_date
 41.     if _rc == 0 {
 42.         gen temp = word(strtrim(g3_reported_date), 1)
 43.         gen crash_date = date(temp, "MDY")
 44.         replace crash_date = date(temp, "DMY") if missing(crash_date)
 45.         replace crash_date = date(temp, "YMD") if missing(crash_date)
 46.         replace crash_date = floor(real(temp)) + td(30dec1899) if missing(
> crash_date)
 47.         drop temp
 48.     }
 49.     else {
 50.         local date_format : format g3_reported_date
 51.         if substr("`date_format'", 1, 3) == "%tc" gen crash_date = dofc(g3
> _reported_date)
 52.         else gen crash_date = g3_reported_date
 53.     }
 54.     format crash_date %td
 55.     count if missing(crash_date)
 56.     di as txt r(N) " crashes with no date (kept in `file_year')"
 57.     count if year(crash_date) != `file_year'
 58.     di as txt r(N) " crashes dated outside `file_year' (kept in `file_year
> ')"
 59.     * Stop here, not in Section 4, if the dates were not read
.     if r(N) > 0.01 * _N {
 60.         list g3_reported_date in 1/5
 61.         error 459
 62.     }
 63. 
.     * eCrash covers 2019 from the switch date, so later ReportBeam records ar
> e dropped
.     * DECISION (pending): about 1,200 late records, most of them not in eCras
> h
.     if `file_year' == 2019 {
 64.         count if crash_date >= $ms_switch & !missing(crash_date)
 65.         di as txt "Dropping " r(N) " ReportBeam crashes on or after the eC
> rash switch"
 66.         drop if crash_date >= $ms_switch & !missing(crash_date)
 67.     }
 68. 
.     * Vehicle and person rows of dropped crashes have no match and are discar
> ded
.     merge 1:1 intcrashid using `vehicles'
 69.     drop if _merge == 2
 70.     drop _merge
 71.     merge 1:1 intcrashid using `persons'
 72.     drop if _merge == 2
 73.     drop _merge
 74. 
.     * Crashes with no vehicle or person rows: no animal, no alcohol, unknown 
> severity
.     foreach v in is_animal is_alcohol sev_rank {
 75.         replace `v' = 0 if missing(`v')
 76.     }
 77. 
.     rename g1_county_nmbr county_nmbr
 78.     rename g7_fatal_cnt total_fatalities
 79.     rename g8_injury_cnt total_injuries
 80.     gen year = `file_year'
 81.     * Crash IDs are numeric here and text in eCrash, so they are not kept
.     keep county_nmbr      ///
>          year             ///
>          crash_date       ///
>          total_fatalities ///
>          total_injuries   ///
>          sev_rank         ///
>          is_animal        ///
>          is_alcohol
 82. 
.     if !`is_first' append using `rb_all'
 83.     save `rb_all', replace
 84.     local is_first = 0
 85. }

