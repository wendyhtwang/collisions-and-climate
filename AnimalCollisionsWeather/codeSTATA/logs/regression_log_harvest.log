. *=============================================================================
> =
. * SECTION 6: QC
. *=============================================================================
> =
. 
. /*------------------------------------------------------------------------
> 
> Four things to check:
> 
>   (a) the four panels rest on identical samples -- asserted, because if
>       they ever diverge the panels stop being comparable down a column;
>   (b) the estimation samples are the sizes this vintage should give --
>       a NOTE, not an assert, since these depend on the panel vintage;
>   (c) 1981 really does contribute nothing, and for the reason we think
>       ([DECIDE] 2);
>   (d) how unbalanced the panel actually is, since that is now a feature
>       of the design rather than something ruled out.
> 
> ------------------------------------------------------------------------*/
. 
. *--------------------------------- 6a. ---------------------------------------
. 
. display as text _newline "  estimation-sample size by winter measure (col 4 sp
> ec):"

  estimation-sample size by winter measure (col 4 spec):

. local _prev = -1

. foreach v in mean_winter_temp warm_winter_1sd wsi_cold_days winter_severity_in
> dex {
  2.     quietly count if $SFULL & !missing($Y, `v', population, pop_share_5_9, 
> mean_temp_c_m3)
  3.     local _thisn = r(N)
  4.     display as text "    " %-24s "`v'" %9.0fc `_thisn'
  5.     if `_prev' != -1 {
  6.         assert `_thisn' == `_prev'
  7.     }
  8.     local _prev = `_thisn'
  9. }
    mean_winter_temp           30,272
    warm_winter_1sd            30,272
    wsi_cold_days              30,272
    winter_severity_index      30,272

. display as text "  all four panels rest on the same estimation sample"
  all four panels rest on the same estimation sample

. 
. *--------------------------------- 6b. ---------------------------------------
. 
. quietly {

. local _nsf : word count `_sf'

. local _nsa : word count `_sa'

. 
. display as text _newline "  cols 1-4: `_nf' obs | `_cf' counties | `_nsf' stat
> es | `_y0'-`_y1'"

  cols 1-4: 30272 obs | 1577 counties | 19 states | 1982-2025

. display as text "    states: `_sf'"
    states: AR CA DE FL GA IA IN KY MD MI MN MO NC NY OH TN VA WI WV

. display as text "  col 5:    `_na2' obs | `_ca' counties | `_nsa' states"
  col 5:    26801 obs | 1082 counties | 14 states

. display as text "    states: `_sa'"
    states: AR CA DE IN KY MD MO NC NY OH TN VA WI WV

. 
. * Expected on the current vintage: 30,272 / 1,577 / 19 and 26,801 / 1,082 / 14
> .
. if `_nf' != 30272 | `_cf' != 1577 {
.     display as error "  NOTE: expected 30,272 obs / 1,577 counties in cols 1-4
> ;" ///
>         " got `_nf' / `_cf'. Check the merged-panel vintage before using this 
> table."
. }

. if `_na2' != 26801 | `_ca' != 1082 {
.     display as error "  NOTE: expected 26,801 obs / 1,082 counties in col 5;" 
> ///
>         " got `_na2' / `_ca'. Check the merged-panel vintage before using this
>  table."
. }

. 
. *--------------------------------- 6c. ---------------------------------------
. 
. * 1981 contributes nothing because mean_winter_temp needs December of 1980 and
. * the PRISM extraction starts in 1981.
. quietly count if year == 1981 & !missing(harvest_total)

. local _h81 = r(N)

. quietly count if year == 1981 & !missing(mean_winter_temp)

. local _w81 = r(N)

. display as text _newline "  1981: `_h81' county-years with harvest, `_w81' wit
> h a winter measure"

  1981: 496 county-years with harvest, 0 with a winter measure

. if `_w81' == 0 {
.     display as text "    -> 1981 drops from every column (winter needs Dec 198
> 0; PRISM starts 1981)"
    -> 1981 drops from every column (winter needs Dec 1980; PRISM starts 1981)
. }

. 
. *--------------------------------- 6d. ---------------------------------------
. 
. * How unbalanced is the panel? Reported -- imbalance is accepted
. * at this stage, but the shape of it should be on the record.
. preserve

.     keep if $SFULL & !missing($Y, mean_winter_temp)
