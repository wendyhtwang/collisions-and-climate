. * they are reported zeros, not missing data.
. quietly count if $SFULL & harvest_total == 0

. local _nzero = r(N)

. display as text _newline "  county-years with harvest_total == 0, dropped by l
> og(): `_nzero'"

  county-years with harvest_total == 0, dropped by log(): 103

. if `_nzero' > 0 {
.     preserve
.         keep if $SFULL & harvest_total == 0
(151,025 observations deleted)
