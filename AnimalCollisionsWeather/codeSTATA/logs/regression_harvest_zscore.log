. do "/tmp/SD1954717.000000"

. global pptmode "days"          // "days" | "total" | "both"

. assert inlist("$pptmode", "days", "total", "both")

. 
. global wctrl ""

. local _snowkeep ""

. local _snowdrop ""

. forvalues m = 3/11 {
  2.     global wctrl "$wctrl mean_temp_c_m`m'"
  3.     if inlist("$pptmode", "days", "both") {
  4.         global wctrl "$wctrl days_precip_above_10mm_m`m'"
  5.     }
  6.     if inlist("$pptmode", "total", "both") {
  7.         global wctrl "$wctrl ppt_total_m`m'"
  8.     }
  9.     * A snowfall month is included only if it actually varies on THIS sampl
> e.
.     * On the old 2005-2014 window July and August were identically zero and
.     * were excluded by name; on the full 1981+ panel they are not. Testing
.     * rather than hard-coding means the control set follows the sample instead
.     * of a fact that is no longer true.
.     quietly summarize total_snowfall_mm_m`m' if $SFULL
 10.     if r(N) > 0 & r(max) > 0 {
 11.         global wctrl "$wctrl total_snowfall_mm_m`m'"
 12.         local _snowkeep "`_snowkeep' m`m'"
 13.     }
 14.     else {
 15.         local _snowdrop "`_snowdrop' m`m'"
 16.     }
 17. }

. 
. local _nsnow : word count `_snowkeep'

. local _nppt = cond("$pptmode" == "both", 18, 9)

. local _nwexp = 9 + `_nppt' + `_nsnow'

. 
. local _nw : word count $wctrl

. display as text "  weather controls (Mar-Nov of year t, pptmode = $pptmode): `
> _nw'"
  weather controls (Mar-Nov of year t, pptmode = days): 27

. display as text "    snowfall months kept:   `_snowkeep'"
    snowfall months kept:    m3 m4 m5 m6 m7 m8 m9 m10 m11

. if "`_snowdrop'" != "" {
.     display as text "    snowfall months dropped (no variation): `_snowdrop'"
. }

. assert `_nw' == `_nwexp'

. 
end of do-file

