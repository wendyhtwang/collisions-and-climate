. *=============================================================================
> =
. * SECTION 6: QC
. *=============================================================================
> =
. 
. /*------------------------------------------------------------------------
> 
> Five things to check:
> 
>   (a) the four panels rest on the same estimation sample, column by column
>       -- asserted off e(), because if they ever diverge the panels stop
>       being comparable down a column AND the specification block at the
>       bottom, which is Panel D's, is silently wrong for A, B and C;
>       
>   (b) the estimation samples are the sizes this vintage should give --
>       a NOTE, not an assert, since these depend on the panel vintage;
>       
>   (c) 1981 really does contribute nothing (decision 2);
>   
>   (d) how unbalanced the panel actually is, since that is now a feature
>       of the design rather than something ruled out;
>       
>   (f) the tails of the rate, and what trimming them would do (decision 1
>       keeps the zeros; 6f tests the other end);
>       
>   (g) where the sample sits in time and in provenance (decision 14).
> 
> And one check Table 1 does not need: (b) also confirms that this table's
> sample is Table 1's sample PLUS the retained zeros and nothing else. If
> that ever stops holding, the two tables have diverged for a second reason
> and the comparison between them is no longer clean.
> 
> ------------------------------------------------------------------------*/
. 
. *--------------------------------- 6a. ---------------------------------------
. 
. /*------------------------------------------------------------------------
> 
> Read off e(), not off a -missing()- proxy.
> 
> This check used to count rows on
> 
>     !missing($Y, `v', population, pop_share_5_9, mean_temp_c_m3)
> 
> -- three of the 44 right-hand-side variables, plus population, which is
> the outcome's denominator here but is not a regressor in any column. It
> could not see the other 24 weather controls or the other 16 age shares, it
> never looked at column 5, and it could not see singleton dropping
> (decision 15) under any circumstances, because reghdfe drops those groups
> AFTER the missing-value test. It would have passed on samples that
> genuinely differed.
> 
> The scalars below come off the 20 regressions that were actually run, so
> the check now tests the thing it claims to test, in all five columns, on
> observations, clusters and counties at once.
> 
> ------------------------------------------------------------------------*/
. 
. display as text _newline "  estimation sample by column, all four panels (e(N)
> ):"

  estimation sample by column, all four panels (e(N)):

. display as text "    col           A          B          C          D   single
> tons"
    col           A          B          C          D   singletons

. local _sampbad 0

. forvalues j = 1/$NCOL {
  2.     display as text "    `j'   " _continue
  3.     foreach P in A B C D {
  4.         display as text %10.0fc scalar(eN_`P'`j') _continue
  5.     }
  6.     display as text "   " %8.0fc scalar(eS_A`j')
  7.     foreach P in B C D {
  8.         if scalar(eN_`P'`j') != scalar(eN_A`j') ///
>          | scalar(eK_`P'`j') != scalar(eK_A`j') ///
>          | scalar(eC_`P'`j') != scalar(eC_A`j') {
  9.             display as error "    column `j': panel `P' is not on panel A's
>  sample"
 10.             local _sampbad = 1
 11.         }
 12.     }
 13. }
    1       30,370    30,370    30,370    30,370          0
    2       30,370    30,370    30,370    30,370          0
    3       30,370    30,370    30,370    30,370          0
    4       30,370    30,370    30,370    30,370          0
    5       26,895    26,895    26,895    26,895          0

. if `_sampbad' {
.     display as error ""
.     display as error "  The four panels no longer share an estimation sample."
.     display as error "  Two things break at once: the coefficients stop being"
.     display as error "  comparable down a column, and the specification block 
> at"
.     display as error "  the bottom of the table -- which is Panel D's -- becom
> es"
.     display as error "  wrong for the panels above it. Find which winter measu
> re"
.     display as error "  went missing where before using this table."
. }

. assert `_sampbad' == 0

. display as text "  all four panels rest on the same estimation sample, column 
> by column"
  all four panels rest on the same estimation sample, column by column

. 
. *--------------------------------- 6b. ---------------------------------------
. 
. /*------------------------------------------------------------------------
> 
> Two different numbers, and the gap between them is the thing to watch:
> 
>     _nf / _cf    county-years and counties with complete data -- what the
>                  sample would be if reghdfe kept every group;
>                  
>     e(N)         what it actually estimated on, after singleton dropping.
> 
> [VERIFIED 09/17] They agree on this vintage: refitting the whole table
> independently lands on 30,370 and 26,895, the same numbers the counts
> below produce. Every county in the estimation sample is observed at least
> twice and the thinnest state x year cell holds three counties (Delaware),
> so no group is a singleton. If they ever come apart, the gap is reghdfe
> dropping groups (decision 15) and not a hole in the data -- the table is
> still right, because it reports e(N), but the expected numbers below have
> stopped meaning what they say.
> 
> ------------------------------------------------------------------------*/
. 
. quietly {

. local _nsf : word count `_sf'

. local _nsa : word count `_sa'

. 
. display as text _newline "  cols 1-4: `_nf' obs | `_cf' counties | `_nsf' stat
> es | `_y0'-`_y1'"

  cols 1-4: 30370 obs | 1578 counties | 19 states | 1982-2025

. display as text "    states: `_sf'"
    states: AR CA DE FL GA IA IN KY MD MI MN MO NC NY OH TN VA WI WV

. display as text "  col 5:    `_na2' obs | `_ca' counties | `_nsa' states"
  col 5:    26895 obs | 1083 counties | 14 states

. display as text "    states: `_sa'"
    states: AR CA DE IN KY MD MO NC NY OH TN VA WI WV

. 
. * Expected on the current vintage: 30,370 / 1,578 / 19 and 26,895 / 1,083 / 14
> .
. if `_nf' != 30370 | `_cf' != 1578 {
.     display as error "  NOTE: expected 30,370 obs / 1,578 counties in cols 1-4
> ;" ///
>         " got `_nf' / `_cf'. Check the merged-panel vintage before using this 
> table."
. }

. if `_na2' != 26895 | `_ca' != 1083 {
.     display as error "  NOTE: expected 26,895 obs / 1,083 counties in col 5;" 
> ///
>         " got `_na2' / `_ca'. Check the merged-panel vintage before using this
>  table."
. }

. 
. * Decision 1: this sample must be Table 1's plus the retained zeros, exactly.
. * !missing(harvest_total) is explicit rather than implied: harvest_total > 0
. * is TRUE on a missing value in Stata, and the !missing() list that follows
. * is the only reason this count is right today.
. quietly count if $SFULL & harvest_total > 0 & !missing(harvest_total) & ///
>     !missing($Y, mean_winter_temp, population, pop_share_5_9, mean_temp_c_m3)

. local _nnozero = r(N)

. display as text _newline "  excluding the retained zeros: `_nnozero' obs" ///
>     "  (Table 1's sample -- log(harvest) drops exactly these zeros)"

  excluding the retained zeros: 30272 obs  (Table 1's sample -- log(harvest) dro
> ps exactly these zeros)

. assert `_nf' == `_nnozero' + $NZEROEST

. if `_nnozero' != 30272 {
.     display as error "  NOTE: expected 30,272 obs once the zeros come out, to 
> match" ///
>         " regression_log_harvest.do; got `_nnozero'. The two tables have diver
> ged" ///
>         " for some reason other than the zeros -- find it before comparing the
> m."
. }

. 
