  3.     if _rc {
  4.         display as error "  not on the ado-path: `ado'"
  5.         local _pkgmissing 1
  6.     }
  7. }

. if `_pkgmissing' {
.     display as error ""
.     display as error "  The files above are not visible to this Stata session.
> "
.     display as error "  If they are genuinely not installed, run the ssc insta
> ll"
