>         title("Panel `P': `x'")
 58. 
.     *--- and into the log, where it can be read without leaving Stata --------
.     esttab c1 c2 c3 c4 c5, ///
>         keep(`x') coeflabel(`x' "`xl'") ///
>         cells(b(star fmt(%9.4f)) se(par fmt(%9.4f))) ///
>         stats(r2_within r2 n_clust n_county N, ///
>               fmt(%9.3f %9.3f %9.0gc %9.0gc %9.0gc) ///
>               labels("Within R-squared" "R-squared (incl. FE)" ///
>                      "# of clusters" "# of counties" "# of obs")) ///
>         starlevels(* 0.10 ** 0.05 *** 0.01) ///
>         mtitles("(1)" "(2)" "(3)" "(4)" "(5)") nonumbers collabels(none)
 59. 
.     *--- what each column actually estimated on ------------------------------
> --
.     * Read back off the stored estimates, not recomputed: e(N) is the sample
.     * AFTER reghdfe dropped singleton groups, which no -missing()- count can
.     * reproduce (decision 15). Section 6a compares these across panels.
.     forvalues j = 1/$NCOL {
 60.         quietly estimates restore c`j'
 61.         scalar eN_`P'`j' = e(N)
 62.         scalar eK_`P'`j' = e(N_clust)
 63.         scalar eC_`P'`j' = e(n_county)
 64.         scalar eS_`P'`j' = e(n_sing)
 65.     }
 66. end

. 
. * Cleared first so that running this file a section at a time in the do-editor
. * cannot leave a stale scalar from an earlier run for Section 6a to compare
. * against and quietly pass.
. capture scalar drop eN_* eK_* eC_* eS_*

